# Determinism grep gate — docs/cpp/determinism-cpp.md.
# Sim code (include/sim/*, src/*) must not contain float/double/std::unordered_map/
# std::hash/<random>/<chrono>/<thread>/<mutex>/<atomic>. net/ transport code is exempt.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(dirs "${root}/include" "${root}/src")
set(banned "float|double|unordered_map|std::hash|<random>|<chrono>|<thread>|<mutex>|<atomic>")
set(fail 0)
foreach(dir ${dirs})
  file(GLOB_RECURSE files RELATIVE ${root} "${dir}/*")
  foreach(f ${files})
    string(FIND "${f}" "net" netpos)
    if(NOT netpos GREATER -1)
      file(READ "${root}/${f}" content)
      string(REGEX REPLACE "//[^\n]*" "" content "${content}")
      if(content MATCHES "${banned}")
        message(FATAL_ERROR "grep gate: banned determinism token found in ${f}")
        set(fail 1)
      endif()
    endif()
  endforeach()
endforeach()
if(NOT fail)
  message(STATUS "grep gate OK (no banned tokens in sim code)")
endif()
